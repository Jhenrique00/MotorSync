{
  "name": "motorsync-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check": "expo install --check",
    "test": "node --test tests/*.test.cjs",
    "export": "expo export --platform all",
    "test:ui": "node tests/finance-ui.cjs",
    "format": "prettier --write app src tests",
    "format:check": "prettier --check app src tests",
    "test:live:explore": "node tests/explore-live.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "57.0.32",
    "expo-constants": "57.0.23",
    "expo-font": "~57.0.4",
    "expo-image-picker": "57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "57.0.30",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chart-kit": "7.0.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.6.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
